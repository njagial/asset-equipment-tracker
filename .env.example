# --- Core -------------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (docker compose provides this on 127.0.0.1:5432)
DATABASE_URL=postgres://assets:assets@127.0.0.1:5432/assets
DJANGO_DATABASE_SSL=false

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Notifications
NOTIFY_EMAIL=ops@example.com
SLACK_WEBHOOK_URL=
MAINTENANCE_LEAD_DAYS=3
DEFAULT_FROM_EMAIL=asset-tracker@example.com

# QR/scan absolute URLs (used in payloads and printed labels)
SITE_BASE_URL=http://127.0.0.1:8000
